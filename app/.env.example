# 로컬 개발용 환경 변수. 실제 값을 넣은 뒤 .env 로 복사해서 사용하세요 (.env는 git에 커밋하지 않음).

# Terraform 배포 후 출력되는 값 (terraform output foundry_endpoint)
# kind="AIServices" 계정은 services.ai.azure.com 도메인만 OpenAI Chat Completions 경로를 라우팅함
# (cognitiveservices.azure.com, openai.azure.com 도메인은 404).
AZURE_OPENAI_ENDPOINT=https://danny-personal-gpt-dev-msf.services.ai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENTS=gpt-5.6-sol,gpt-6-astra

# 로컬에서 az login으로 인증한다면 비워두세요 (DefaultAzureCredential 사용).
# App Service 배포 환경에서는 Managed Identity를 사용하므로 이 값을 설정하지 않는 것을 권장합니다.
# AZURE_OPENAI_API_KEY=

PORT=8080
